<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="RoomDetailSectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:textColor">@color/home_title</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- Base application theme. -->
    <style name="Base.Theme.Homestay" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Homestay" parent="Base.Theme.Homestay" />

    <style name="Theme.RoomGo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/home_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_badge</item>
        <item name="postSplashScreenTheme">@style/Theme.Homestay</item>
    </style>
    
    <!-- Admin theme - Force light mode only -->
    <style name="Theme.Homestay.Admin" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
