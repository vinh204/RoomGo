<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/home_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/home_surface" app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar" android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" android:background="@color/home_surface"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="@color/home_title" app:title="Chi tiết phòng"
            app:titleTextColor="@color/home_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="112dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="280dp"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp"
                app:cardCornerRadius="20dp" app:cardElevation="0dp">
                <ImageView android:id="@+id/img_room" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:background="@color/home_divider"
                    android:contentDescription="Hình ảnh phòng" android:scaleType="centerCrop"
                    android:src="@drawable/ic_room_placeholder" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end" android:layout_margin="14dp"
                    android:background="@drawable/bg_image_counter" android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp" android:text="Ảnh phòng"
                    android:textColor="@android:color/white" android:textSize="12sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="20dp">
                <TextView android:id="@+id/tv_room_name" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:textColor="@color/home_title" android:textSize="26sp"
                    android:textStyle="bold" tools:text="Villa Biển Xanh" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/tv_location" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/home_subtitle"
                        android:textSize="14sp" tools:text="Vũng Tàu" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginHorizontal="7dp" android:text="•"
                        android:textColor="@color/home_subtitle" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="★" android:textColor="#F59E0B" android:textSize="15sp" />
                    <TextView android:id="@+id/tv_rating" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="4dp"
                        android:textColor="@color/home_title" android:textStyle="bold" tools:text="4.9" />
                    <TextView android:id="@+id/tv_review_count" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="4dp"
                        android:textColor="@color/home_subtitle" android:textSize="14sp"
                        tools:text="(203 đánh giá)" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/tv_room_type" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:background="@drawable/bg_chip"
                        android:paddingHorizontal="12dp" android:paddingVertical="7dp"
                        android:textColor="@color/home_primary" android:textSize="13sp"
                        android:textStyle="bold" tools:text="Villa" />
                    <TextView android:id="@+id/tv_availability_status" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:background="@drawable/bg_available_chip" android:paddingHorizontal="12dp"
                        android:paddingVertical="7dp" android:text="Còn phòng" android:textColor="#18794E"
                        android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" app:cardBackgroundColor="@color/home_surface"
                    app:cardCornerRadius="16dp" app:cardElevation="0dp"
                    app:strokeColor="@color/home_divider" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:paddingVertical="18dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▣" android:textColor="@color/home_primary" android:textSize="20sp" />
                            <TextView android:id="@+id/tv_area" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/home_title" android:textStyle="bold" tools:text="80 m²" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Diện tích" android:textColor="@color/home_subtitle" android:textSize="12sp" />
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="58dp" android:background="@color/home_divider" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♟" android:textColor="@color/home_primary" android:textSize="20sp" />
                            <TextView android:id="@+id/tv_max_guests" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/home_title" android:textStyle="bold" tools:text="10 người" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sức chứa" android:textColor="@color/home_subtitle" android:textSize="12sp" />
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="58dp" android:background="@color/home_divider" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◫" android:textColor="@color/home_primary" android:textSize="20sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Riêng tư" android:textColor="@color/home_title" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Không gian" android:textColor="@color/home_subtitle" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView style="@style/RoomDetailSectionTitle" android:text="Giới thiệu" />
                <TextView android:id="@+id/tv_description" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="9dp"
                    android:ellipsize="end" android:lineSpacingExtra="4dp" android:maxLines="3"
                    android:textColor="@color/home_text" android:textSize="15sp" />
                <TextView android:id="@+id/tv_description_toggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:paddingVertical="5dp" android:text="Xem thêm"
                    android:textColor="@color/home_primary" android:textStyle="bold" />

                <TextView style="@style/RoomDetailSectionTitle" android:text="Tiện nghi" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" app:cardBackgroundColor="@color/home_surface"
                    app:cardCornerRadius="14dp" app:cardElevation="0dp"
                    app:strokeColor="@color/home_divider" app:strokeWidth="1dp">
                    <TextView android:id="@+id/tv_amenities" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:drawableStart="@android:drawable/ic_menu_compass"
                        android:drawablePadding="12dp" android:lineSpacingExtra="5dp" android:padding="16dp"
                        android:textColor="@color/home_text" android:textSize="14sp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView style="@style/RoomDetailSectionTitle" android:text="Vị trí" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" app:cardBackgroundColor="@color/home_surface"
                    app:cardCornerRadius="14dp" app:cardElevation="0dp"
                    app:strokeColor="@color/home_divider" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp"
                            android:contentDescription="Địa chỉ" android:src="@android:drawable/ic_menu_mylocation"
                            android:tint="@color/home_primary" />
                        <TextView android:id="@+id/tv_address" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_marginStart="13dp"
                            android:layout_weight="1" android:textColor="@color/home_text" android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView style="@style/RoomDetailSectionTitle" android:text="Phòng và khung giờ còn trống" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="Chọn Đặt ngay để kiểm tra ngày nhận, ngày trả và tổng chi phí."
                    android:textColor="@color/home_subtitle" android:textSize="13sp" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_slots"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:nestedScrollingEnabled="false" />
                <TextView android:id="@+id/tv_price" android:layout_width="1dp"
                    android:layout_height="1dp" android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" app:cardBackgroundColor="@color/home_surface"
        app:cardCornerRadius="0dp" app:cardElevation="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="88dp"
            android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="20dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Giá mỗi đêm" android:textColor="@color/home_subtitle" android:textSize="12sp" />
                <TextView android:id="@+id/tv_bottom_price" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="3dp"
                    android:textColor="@color/home_primary" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_book"
                android:layout_width="132dp" android:layout_height="54dp" android:text="Đặt ngay"
                android:textAllCaps="false" android:textColor="@android:color/white"
                android:textSize="16sp" android:textStyle="bold" app:backgroundTint="@color/home_primary"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
