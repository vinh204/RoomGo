  <TextView android:id="@+id/tv_payment_method" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/home_subtitle" android:textSize="14sp" />
  <TextView android:id="@+id/tv_customer_contact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/home_subtitle" android:textSize="13sp" />
