<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardBackgroundColor="@color/home_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/home_divider"
    app:strokeWidth="1dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tv_reviewer_avatar" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_reviewer_avatar" android:gravity="center" android:textColor="@android:color/white" android:textSize="17sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tv_reviewer_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/home_title" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_review_stars" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#FFB000" android:textSize="17sp" />
            </LinearLayout>
            <TextView android:id="@+id/tv_review_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/home_subtitle" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/tv_review_comment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="54dp" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:textColor="@color/home_text" android:textSize="14sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
