<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/home_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_admin_account"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_admin_avatar"
            android:clickable="true"
            android:contentDescription="@string/admin_account"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_admin_headset" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/admin_dashboard_title"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/btn_admin_notifications"
            layout="@layout/action_notification_badge"
            android:layout_width="48dp"
            android:layout_height="match_parent" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/admin_overview_today" android:textColor="@color/home_title" android:textSize="21sp" android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_dashboard_period" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="36dp" android:backgroundTint="#EAF3FF" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Tháng này ▾" android:textAllCaps="false" android:textColor="@color/home_primary" android:textSize="13sp" android:textStyle="bold" app:cornerRadius="18dp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/admin_overview_subtitle" android:textColor="@color/home_subtitle" android:textSize="13sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView android:id="@+id/card_stat_rooms" android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="#EAF3FF" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="#C8D7EA" app:strokeWidth="1dp">
                    <TextView android:id="@+id/tv_stat_rooms" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/admin_rooms_count_placeholder" android:textColor="@color/home_primary" android:textSize="15sp" android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/card_stat_users" android:layout_width="0dp" android:layout_height="88dp" android:layout_marginStart="10dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="#EAF8F1" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="#C8DED3" app:strokeWidth="1dp">
                    <TextView android:id="@+id/tv_stat_users" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/admin_users_count_placeholder" android:textColor="#167A50" android:textSize="15sp" android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/card_stat_pending" android:layout_width="0dp" android:layout_height="88dp" android:layout_marginStart="10dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="#FFF3E2" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="#E7D5BC" app:strokeWidth="1dp">
                    <TextView android:id="@+id/tv_stat_pending" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/admin_pending_count_placeholder" android:textColor="#A55A00" android:textSize="15sp" android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/home_surface" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/home_divider" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/admin_revenue" android:textColor="@color/home_title" android:textSize="17sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:baselineAligned="false" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/admin_revenue_actual" android:textColor="@color/home_subtitle" android:textSize="13sp" />
                            <TextView android:id="@+id/tv_stat_revenue_actual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0 đ" android:textColor="#167A50" android:textSize="18sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/admin_revenue_expected" android:textColor="@color/home_subtitle" android:textSize="13sp" />
                            <TextView android:id="@+id/tv_stat_revenue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0 đ" android:textColor="@color/home_primary" android:textSize="18sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/tv_revenue_comparison" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="0% so với kỳ trước" android:textColor="@color/home_subtitle" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/card_period_summary" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="12dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/home_surface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/home_divider" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tv_stat_staying" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/home_primary" android:textSize="19sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Đang lưu trú" android:textColor="@color/home_subtitle" android:textSize="12sp" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="34dp" android:background="@color/home_divider" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tv_stat_completed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#167A50" android:textSize="19sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Hoàn thành" android:textColor="@color/home_subtitle" android:textSize="12sp" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="34dp" android:background="@color/home_divider" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tv_stat_cancelled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#D14343" android:textSize="19sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Đã hủy" android:textColor="@color/home_subtitle" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/admin_recent_bookings" android:textColor="@color/home_title" android:textSize="19sp" android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardBackgroundColor="@color/home_surface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/home_divider" app:strokeWidth="1dp">
                <LinearLayout android:id="@+id/recent_bookings_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/tv_management_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Quản lý hệ thống" android:textColor="@color/home_title" android:textSize="19sp" android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView android:id="@+id/card_manage_rooms" android:layout_width="match_parent" android:layout_height="86dp" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/home_surface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/home_divider" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="15dp">
                    <TextView android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_admin_icon_blue" android:gravity="center" android:text="P" android:textColor="@color/home_primary" android:textSize="21sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quản lý phòng" android:textColor="@color/home_title" android:textSize="17sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Thêm, chỉnh sửa và thiết lập nổi bật" android:textColor="@color/home_subtitle" android:textSize="13sp" /></LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/home_primary" android:textSize="28sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/card_manage_bookings" android:layout_width="match_parent" android:layout_height="86dp" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/home_surface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/home_divider" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="15dp">
                    <TextView android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_admin_icon_orange" android:gravity="center" android:text="Đ" android:textColor="#A55A00" android:textSize="21sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quản lý đặt phòng" android:textColor="@color/home_title" android:textSize="17sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Duyệt và cập nhật trạng thái booking" android:textColor="@color/home_subtitle" android:textSize="13sp" /></LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/home_primary" android:textSize="28sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/card_view_users" android:layout_width="match_parent" android:layout_height="86dp" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/home_surface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/home_divider" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="15dp">
                    <TextView android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_admin_icon_green" android:gravity="center" android:text="N" android:textColor="#167A50" android:textSize="21sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quản lý người dùng" android:textColor="@color/home_title" android:textSize="17sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Xem và cập nhật tài khoản khách" android:textColor="@color/home_subtitle" android:textSize="13sp" /></LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/home_primary" android:textSize="28sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include layout="@layout/layout_admin_bottom_nav" />
</LinearLayout>
