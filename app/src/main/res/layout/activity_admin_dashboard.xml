<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:forceDarkAllowed="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/home_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quản trị RoomGo"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView android:id="@+id/btn_admin_account" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_admin_avatar" android:clickable="true" android:focusable="true" android:gravity="center" android:text="A" android:textColor="@color/home_primary" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tổng quan hôm nay" android:textColor="@color/home_title" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Theo dõi nhanh hoạt động của RoomGo" android:textColor="@color/home_subtitle" android:textSize="13sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" app:cardBackgroundColor="#EAF3FF" app:cardCornerRadius="16dp" app:cardElevation="0dp">
                    <TextView android:id="@+id/tv_stat_rooms" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="0\nPhòng" android:textColor="@color/home_primary" android:textSize="15sp" android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="88dp" android:layout_marginStart="10dp" android:layout_weight="1" app:cardBackgroundColor="#EAF8F1" app:cardCornerRadius="16dp" app:cardElevation="0dp">
                    <TextView android:id="@+id/tv_stat_users" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="0\nNgười dùng" android:textColor="#167A50" android:textSize="15sp" android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="88dp" android:layout_marginStart="10dp" android:layout_weight="1" app:cardBackgroundColor="#FFF3E2" app:cardCornerRadius="16dp" app:cardElevation="0dp">
                    <TextView android:id="@+id/tv_stat_pending" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="0\nChờ duyệt" android:textColor="#A55A00" android:textSize="15sp" android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/home_surface" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/home_divider" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Doanh thu" android:textColor="@color/home_title" android:textSize="17sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thực tế" android:textColor="@color/home_subtitle" android:textSize="13sp" />
                            <TextView android:id="@+id/tv_stat_revenue_actual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0 đ" android:textColor="#167A50" android:textSize="18sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dự kiến" android:textColor="@color/home_subtitle" android:textSize="13sp" />
                            <TextView android:id="@+id/tv_stat_revenue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0 đ" android:textColor="@color/home_primary" android:textSize="18sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tỷ lệ lấp đầy" android:textColor="@color/home_text" android:textSize="14sp" />
                        <TextView android:id="@+id/tv_occupancy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="@color/home_primary" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                    <ProgressBar android:id="@+id/progress_occupancy" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:max="100" android:progress="0" android:progressTint="@color/home_primary" android:progressBackgroundTint="#E5E9F2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Booking mới nhất" android:textColor="@color/home_title" android:textSize="19sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/recent_bookings_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />

            <TextView android:id="@+id/tv_management_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Quản lý hệ thống" android:textColor="@color/home_title" android:textSize="19sp" android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView android:id="@+id/card_manage_rooms" android:layout_width="match_parent" android:layout_height="86dp" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/home_surface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/home_divider" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="15dp">
                    <TextView android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_admin_icon_blue" android:gravity="center" android:text="P" android:textColor="@color/home_primary" android:textSize="21sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quản lý phòng" android:textColor="@color/home_title" android:textSize="17sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Thêm, chỉnh sửa và thiết lập nổi bật" android:textColor="@color/home_subtitle" android:textSize="13sp" /></LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/home_primary" android:textSize="28sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/card_manage_bookings" android:layout_width="match_parent" android:layout_height="86dp" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/home_surface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/home_divider" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="15dp">
                    <TextView android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_admin_icon_orange" android:gravity="center" android:text="Đ" android:textColor="#A55A00" android:textSize="21sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quản lý đặt phòng" android:textColor="@color/home_title" android:textSize="17sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Duyệt và cập nhật trạng thái booking" android:textColor="@color/home_subtitle" android:textSize="13sp" /></LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/home_primary" android:textSize="28sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/card_view_users" android:layout_width="match_parent" android:layout_height="86dp" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/home_surface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/home_divider" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="15dp">
                    <TextView android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_admin_icon_green" android:gravity="center" android:text="N" android:textColor="#167A50" android:textSize="21sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quản lý người dùng" android:textColor="@color/home_title" android:textSize="17sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Xem và cập nhật tài khoản khách" android:textColor="@color/home_subtitle" android:textSize="13sp" /></LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/home_primary" android:textSize="28sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_switch_to_guest" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="24dp" android:text="Xem giao diện khách" android:textAllCaps="false" android:textColor="@color/home_primary" app:backgroundTint="#EAF3FF" app:cornerRadius="16dp" app:strokeWidth="0dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_logout" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:layout_marginBottom="12dp" android:text="Đăng xuất" android:textAllCaps="false" android:textColor="#D14343" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include layout="@layout/layout_admin_bottom_nav" />
</LinearLayout>
