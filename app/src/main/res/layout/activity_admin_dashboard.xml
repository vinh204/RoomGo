<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:forceDarkAllowed="false">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/home_primary">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quản trị RoomGo"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>

        <TextView
            android:id="@+id/tv_admin_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Administrator"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Menu Cards -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tổng quan hôm nay"
                android:textColor="@color/home_title"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_stat_rooms"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:background="#E8F3FF"
                    android:gravity="center"
                    android:text="0\nPhòng"
                    android:textColor="@color/home_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_stat_users"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#EAF7EF"
                    android:gravity="center"
                    android:text="0\nNgười dùng"
                    android:textColor="#18794E"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_stat_pending"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#FFF4E5"
                    android:gravity="center"
                    android:text="0\nChờ duyệt"
                    android:textColor="#9A5B00"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_stat_revenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F3F4F6"
                android:padding="14dp"
                android:text="Doanh thu dự kiến: 0 đ"
                android:textColor="@color/home_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_stat_revenue_actual"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="#EAF7EF" android:padding="14dp"
                android:text="Doanh thu thực tế: 0 đ" android:textColor="#18794E" android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_booking_breakdown"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="#F7F7FA" android:lineSpacingExtra="5dp"
                android:padding="14dp" android:textColor="@color/home_text" />

            <TextView
                android:id="@+id/tv_operational_summary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="#E8F3FF" android:lineSpacingExtra="5dp"
                android:padding="14dp" android:textColor="@color/home_primary" />

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:text="Booking mới nhất"
                android:textColor="@color/home_title" android:textSize="18sp" android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_recent_bookings"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginBottom="18dp"
                android:background="#F7F7FA" android:lineSpacingExtra="6dp" android:padding="14dp"
                android:text="Chưa có booking" android:textColor="@color/home_text" />

            <!-- Quản lý Phòng -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_manage_rooms"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@android:color/white"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="#CCCCCC"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:forceDarkAllowed="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="P"
                        android:textSize="32sp"
                        android:gravity="center"
                        android:background="#E3F2FD"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quản lý Phòng"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thêm, sửa, xóa phòng"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="32sp"
                        android:textColor="#CCCCCC"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Xem Users -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_view_users"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@android:color/white"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="#CCCCCC"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:forceDarkAllowed="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="N"
                        android:textSize="32sp"
                        android:gravity="center"
                        android:background="#FFF3E0"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Người dùng"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xem và quản lý tài khoản"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="32sp"
                        android:textColor="#CCCCCC"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quản lý Bookings -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_manage_bookings"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@android:color/white"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="#CCCCCC"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:forceDarkAllowed="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="Đ"
                        android:textSize="32sp"
                        android:gravity="center"
                        android:background="#F3E5F5"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quản lý đặt phòng"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xem và cập nhật đặt phòng"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="32sp"
                        android:textColor="#CCCCCC"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_switch_to_guest"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="Xem giao diện khách"
        android:textAllCaps="false"
        android:textColor="@color/home_primary"
        app:backgroundTint="@android:color/white"
        app:cornerRadius="12dp"
        app:strokeColor="@color/home_primary"
        app:strokeWidth="1dp" />

    <!-- Logout Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_logout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        android:text="Đăng xuất"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        app:backgroundTint="#FF6B35"
        app:cornerRadius="12dp"/>
</LinearLayout>

