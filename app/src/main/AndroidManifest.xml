<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".HomestayApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_roomgo_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_roomgo_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Homestay"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.RoomGo.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Homestay" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Homestay"
            android:parentActivityName=".ui.auth.LoginActivity" />

        <activity
            android:name=".ui.customer.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.customer.NotificationsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminNotificationsActivity"
            android:exported="false"
            android:theme="@style/Theme.Homestay.Admin" />

        <activity
            android:name=".ui.room.RoomDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.customer.MainActivity" />

        <!-- Admin Activities -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.Homestay.Admin" />

        <activity
            android:name=".ui.admin.AdminRoomsActivity"
            android:exported="false"
            android:parentActivityName=".ui.admin.AdminDashboardActivity"
            android:theme="@style/Theme.Homestay.Admin" />

        <activity
            android:name=".ui.admin.AdminUsersActivity"
            android:exported="false"
            android:parentActivityName=".ui.admin.AdminDashboardActivity"
            android:theme="@style/Theme.Homestay.Admin" />

        <activity
            android:name=".ui.admin.AdminBookingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.admin.AdminDashboardActivity"
            android:theme="@style/Theme.Homestay.Admin" />
    </application>

</manifest>
